# weAID 환경 변수 설정
# 이 파일을 .env로 복사하고 값을 설정하세요
# cp .env.example .env

# ── 필수: Anthropic API Key ──────────────────────────────────────────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ── 선택: 모델 설정 ──────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6

# ── 선택: 서버 설정 ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── 선택: 음성 설정 ──────────────────────────────────────────────────────
VOICE_LANGUAGE=ko-KR
TTS_ENGINE=gtts

# ── 선택: 세션 설정 ──────────────────────────────────────────────────────
MAX_HISTORY=20
